# Database Settings
DB_NAME=shortify_ai
DB_USER=your_username
DB_PASSWORD=your_password
DATABASE_URL=postgresql://your_username:your_password@localhost:5432/shortify_ai

# Security
SECRET_KEY=your_super_secret_jwt_sign_key
ALGORITHM=HS256

# Groq API Key (for Llama 3.3 CreativeDirector)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google AI Studio / Gemini API Keys (For MediaAnalyst - supports rotation)
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY_1=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY_2=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY_3=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# EDL Validation Failure Handling (pass | stop)
# - pass: Bypasses strict validation errors and renders the best generated timeline on the 3rd attempt
# - stop: Throws strict validation exceptions and halts render on errors
EDL_VALIDATION_FAIL=pass